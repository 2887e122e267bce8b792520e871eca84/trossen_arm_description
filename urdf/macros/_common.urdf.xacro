<?xml version="1.0" encoding="utf-8"?>
<robot name="common" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="trossen_black">
    <material name="trossen_black">
      <texture filename="package://trossen_arm_description/meshes/trossen_black.png"/>
    </material>
  </xacro:macro>  <!-- trossen_black -->

  <material name="grey">
        <color rgba="0.2 0.2 0.2 1.0" />
    </material>

    <material name="light_grey">
        <color rgba="0.75 0.75 0.7 1" />
    </material>

    <material name="pink">
        <color rgba="1.0 0.71 0.76 1.0"/>
    </material>

    <material name="blue">
        <color rgba="0.1 0.2 0.6 1.0"/>
    </material>

    <material name="light_blue">
        <color rgba="0.3 0.45 0.78 1.0"/>
    </material>

    <material name="green">
        <color rgba="0.0 0.5 0.0 1.0" />
    </material>

    <material name="orange">
        <color rgba="1.0 0.5 0.0 1.0" />
    </material> 

    <material name="blue_green">
        <color rgba="0.0 0.7 0.7 1.0" />
    </material>

    <material name="yellow">
        <color rgba="1.0 1.0 0.0 1.0"/>
    </material>

    <material name="light_green">
        <color rgba="0.5 1.0 0.5 1.0"/>
    </material>

</robot>
