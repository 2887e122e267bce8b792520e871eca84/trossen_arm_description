<?xml version="1.0" encoding="utf-8"?>
<robot name="common" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="trossen_black">
    <material name="trossen_black">
      <texture filename="package://trossen_arm_description/meshes/trossen_black.png"/>
    </material>
  </xacro:macro>  <!-- trossen_black -->

  <xacro:macro name="maple_tabletop">
    <material name="maple_tabletop">
      <texture filename="package://trossen_arm_description/meshes/maple_tabletop.png"/>
    </material>
  </xacro:macro>  <!-- maple_tabletop -->

  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>

  <material name="gold">
    <color rgba="1.0 0.88 0.35 1.0"/>
  </material>

  <material name="silver">
    <color rgba="0.753 0.753 0.753 1.0"/>
  </material>

</robot>
